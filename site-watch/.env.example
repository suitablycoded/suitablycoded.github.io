# Copy to .env (or set these in your scheduler) and fill in your own values.
# Leave a channel's values empty to switch that channel off.

# Email over SMTP
SITE_WATCH_SMTP_HOST=smtp.example.com
SITE_WATCH_SMTP_PORT=587
SITE_WATCH_SMTP_STARTTLS=true
SITE_WATCH_SMTP_USER=alerts@example.com
SITE_WATCH_SMTP_PASSWORD=change-me
SITE_WATCH_EMAIL_FROM=alerts@example.com
SITE_WATCH_EMAIL_TO=you@example.com

# Generic webhook (receives a JSON POST)
SITE_WATCH_WEBHOOK_URL=https://hooks.example.com/site-watch
